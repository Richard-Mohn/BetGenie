# BetGenie Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ============================================
# DATABASE
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=betgenie
POSTGRES_USER=betgenie
POSTGRES_PASSWORD=

MONGODB_URI=mongodb://localhost:27017/betgenie

REDIS_URL=redis://localhost:6379

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================
# EXTERNAL APIs — Sports Data
# ============================================
# The Odds API (https://the-odds-api.com/)
ODDS_API_KEY=

# Sportradar (Phase 4+)
SPORTRADAR_API_KEY=

# ============================================
# EXTERNAL APIs — News & Media
# ============================================
# NewsAPI (https://newsapi.org/)
NEWS_API_KEY=

# ============================================
# EXTERNAL APIs — Social Media
# ============================================
# Twitter/X API v2
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# Reddit API
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=BetGenie/0.1

# ============================================
# EXTERNAL APIs — Weather
# ============================================
# OpenWeather (https://openweathermap.org/)
OPENWEATHER_API_KEY=

# ============================================
# AI / ML
# ============================================
# OpenAI API (for NLP processing)
OPENAI_API_KEY=

# ============================================
# PAYMENTS
# ============================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# EMAIL
# ============================================
SENDGRID_API_KEY=
FROM_EMAIL=alerts@betgenie.com

# ============================================
# MONITORING
# ============================================
SENTRY_DSN=
